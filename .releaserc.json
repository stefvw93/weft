{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "release": {
    "initialVersion": "0.1.0"
  },
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [{ "breaking": true, "release": "minor" }]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/sync-versions.mjs ${nextRelease.version} && node scripts/bundle-package-docs.mjs && vp run pack",
        "publishCmd": "vp dlx pnpm -r --filter @weftui/core --filter @weftui/dom --filter @weftui/router --filter @weftui/vite publish --access public --no-git-checks",
        "successCmd": "node scripts/release-success.mjs ${nextRelease.version}"
      }
    ],
    "@semantic-release/github"
  ]
}
