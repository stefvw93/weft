{
  "name": "@weftui/router",
  "version": "0.0.0",
  "description": "Universal nested router for Weft: one route tree, server and client, with type-safe params and href",
  "keywords": [
    "effect",
    "nested-routes",
    "router",
    "routing",
    "ssr",
    "weft"
  ],
  "homepage": "https://weftui.dev",
  "bugs": {
    "url": "https://github.com/stefvw93/weft/issues"
  },
  "license": "MIT",
  "author": "Stef van Wijchen",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefvw93/weft",
    "directory": "packages/router"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@weftui/core": "workspace:*",
    "@weftui/dom": "workspace:*"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "jsdom": "^29.1.1",
    "tstyche": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.98 <4.0.0"
  }
}
